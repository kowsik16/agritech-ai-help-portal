# Copy this file to .env for local development. Never commit your real .env.
# For local SQLite, you may leave DATABASE_URL as default or set:
DATABASE_URL=sqlite:///./agritech.db
# MongoDB Atlas connection string (required to persist chat logs and feedback in MongoDB)
MONGODB_URI=
MONGODB_DATABASE=agritech_portal
# Optional AI provider key. If absent or provider times out, FAQ retrieval fallback is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenWeather API key. If absent or request times out, fallback message is shown.
OPENWEATHER_API_KEY=
LOG_LEVEL=INFO
